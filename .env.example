POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-local-master
GRAFANA_ADMIN_PASSWORD=admin
# Module 4: the project as Docker's VM sees it. Airflow mounts the project at this same path so
# containers that PyAirbyte launches from inside Airflow can bind-mount its temp files.
# Docker Desktop on Windows: /run/desktop/mnt/host/<drive>/<path>. Linux/macOS: the real path.
HOST_PROJECT_PATH=/run/desktop/mnt/host/c/projects/test/mini-payments-platform
